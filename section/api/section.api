syntax = "v1"

type (
	Section {
		Id          int    `json:"id"`
		Title       string `json:"title"`
		Description string `json:"description"`
		OrderIndex  int    `json:"orderIndex"`
		Visibility  bool   `json:"visibility"`
	}
	SectionListResp {
		List  []Section `json:"list"`
		Total int64     `json:"total"`
	}
	GetSectionReq {
		Id int64 `path:"id"`
	}
	GetSectionResp {
		Item Section `json:"section"`
	}
)

service section-api {
	@handler SectionList
	get /api/sections returns (SectionListResp)

	@handler Get
	get /api/sections/:id (GetSectionReq) returns (GetSectionResp)
}

